      "name": "1. Authentication & Session",
      "item": [
        {
          "name": "Company Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "}",
                  "if (jsonData.company && jsonData.company.id) {",
                  "    pm.collectionVariables.set('companyId', jsonData.company.id);",
                  "}",
                  "if (jsonData.company && jsonData.company.mcpSlug) {",
                  "    pm.collectionVariables.set('mcpSlug', jsonData.company.mcpSlug);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@softtech.ai\",\n  \"password\": \"AdminPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/company/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "company",
                "login"
              ]
            }
          }
        },
