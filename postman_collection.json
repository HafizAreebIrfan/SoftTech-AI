    {
      "name": "5. Model Context Protocol (MCP) & ChatGPT Actions",
      "item": [
        {
          "name": "OAuth Protected Resource Metadata (RFC 9728)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/mcp/{{mcpSlug}}/.well-known/oauth-protected-resource",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mcp",
                "{{mcpSlug}}",
                ".well-known",
                "oauth-protected-resource"
              ]
            }
          }
        },
        {
          "name": "MCP Server-Sent Events (SSE) Stream",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mcp/{{mcpSlug}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mcp",
                "{{mcpSlug}}"
              ]
            }
          }
        },
        {
          "name": "Execute MCP Tool (JSON-RPC 2.0)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"search_accounts\",\n    \"arguments\": {\n      \"query\": \"Quantum\"\n    }\n  },\n  \"id\": \"req-001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/mcp/{{mcpSlug}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mcp",
                "{{mcpSlug}}"
              ]
            }
          }
        }
